# Application
APP_ENV=development
DEFAULT_USER_ID=demo-user
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long

# Local PostgreSQL database from ../compose.yaml
DATABASE_URL=postgresql+psycopg://robo_blog:robo_blog_password@localhost:5432/robo_blog

# Local development audio storage; configure R2 values to use object storage in deployment.
AUDIO_STORAGE_DIR=./audio_store
R2_BUCKET=replace-with-r2-bucket-name
R2_ENDPOINT_URL=https://replace-with-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_REGION=auto

# OpenAI: transcription and language-model agents
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_BASE_URL=
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
LLM_MODEL=gpt-4o-mini
LLM_STRONG_MODEL=gpt-4.1

# Tavily: research agent
TAVILY_API_KEY=replace-with-tavily-api-key

